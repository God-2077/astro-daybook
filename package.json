{
  "name": "daybook",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=7.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "og": "tsx scripts/make-og-image.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:build": "node --import tsx tests/build/assert-dist.ts",
    "test": "pnpm test:unit && pnpm test:build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@waline/client": "3.16.1",
    "artalk": "2.10.1",
    "astro": "7.4.2",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "katex": "0.19.1",
    "lightgallery": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-math": "6.0.0",
    "sharp": "0.35.5",
    "twikoo": "1.6.44",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-xml-parser": "5.11.2",
    "oxc-transform-react": "0.145.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
