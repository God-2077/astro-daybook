# lightGallery v3 授权 key（正文图片放大层使用）。
# 开源项目（GPLv3 兼容）可发邮件到 contact@lightgalleryjs.com 免费申请，key 以 LIG 开头；
# 闭源项目需购买商业授权。详见 docs/configuration.md 的「图片放大」一节。
# 未设置时构建会回落到下面的临时评估 key：功能全开，只在控制台留一条 not-for-production 警告。
# 用法：复制本文件为 .env，再把值换成正式 key。
PUBLIC_LIGHTGALLERY_LICENSE_KEY=0000-0000-000-0000

# 独立内容仓库（可选）。配置后可用 pnpm content:clone / content:pull 管理内容。
# HTTP(S) 地址可以把 token 直接内联在 URL 中；SSH 地址还需要下面的私钥路径。
# 不要把真实 token 或私钥提交到仓库。详见 docs/dual-repo.md。
CONTENT_REPO_URL=
# 内容仓库克隆到主题仓库下的哪个目录，默认 content。
CONTENT_REPO_DIR=content
# 可选：要拉取的分支；留空使用远端默认分支。
CONTENT_REPO_BRANCH=
# SSH 地址必填：私钥文件路径，支持 ~ 展开或相对主题仓库根目录。
CONTENT_REPO_SSH_KEY=
