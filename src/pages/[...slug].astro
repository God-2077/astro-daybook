---
import CommentsSection from '../components/comments/CommentsSection.astro';
import LockedContent from '../components/content/LockedContent.tsx';
import RenderedBody from '../components/content/RenderedBody.astro';
import Toc from '../components/content/Toc.astro';
import { siteConfig } from '../config/site';
import { localeMeta, t } from '../i18n/current';
import { getLockedMessages } from '../i18n/react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { commentOptions } from '../lib/comments';
import { formatContentDate, formatDisplayDate, weekdayLabel, zonedParts } from '../lib/content/date';
import { estimateReadingTime, getDescription } from '../lib/content/description';
import { encryptContent } from '../lib/content/encrypt';
import { getAllEntries, getEntryByUrl, isIndexable, taxonomyHref } from '../lib/content/entries';
import { renderEntry } from '../lib/content/render';
import { getEntryTitle } from '../lib/content/title';
import { absoluteUrl } from '../lib/site';
import type { PostEntry } from '../types/content';

export async function getStaticPaths() {
  const entries = await getAllEntries();
  return entries
    .filter((entry) => !entry.data.draft || import.meta.env.DEV)
    .map((entry) => ({
      params: { slug: entry.url.replace(/^\//, '') },
      props: { url: entry.url },
    }));
}

const url = `/${Astro.params.slug ?? ''}`;
const entry = await getEntryByUrl(url);
if (!entry) throw new Error(`找不到内容：${url}`);

const kind = entry.collection === 'post' ? 'post' : 'daily';
const isPost = kind === 'post';
const post = isPost ? (entry as PostEntry) : undefined;
const isLocked = Boolean(entry.data.password);
const title = getEntryTitle(entry, 'detail');
const hasTitle = entry.data.title.trim().length > 0;
const description = getDescription(entry, siteConfig.labels.diary);
const dateIso = formatContentDate(entry.data.date, siteConfig.timezone, 'yyyy-MM-dd');
const reading = estimateReadingTime(entry.body, entry.format);
const railParts = zonedParts(entry.data.date, siteConfig.timezone);
const listingHref = isPost ? '/posts' : '/';
const typeLabel = isPost ? t('content.post') : siteConfig.labels.diary;
const category = entry.collection === 'post' ? entry.data.categories[0] : entry.data.category;
const postCategory = post?.data.categories[0];
const tags = post?.data.tags ?? [];
const keywords = post?.data.keywords ?? [];
const section = post?.data.categories[0];
const rendered = await renderEntry(entry);
const headings = rendered.headings;
const endLabel = t('detail.end', { date: formatContentDate(entry.data.date, siteConfig.timezone, 'yyyy.MM') });
const lockedMessages = getLockedMessages(siteConfig.lang, kind, siteConfig.labels.diary);
const payload =
  isLocked && entry.data.password && rendered.format === 'md'
    ? encryptContent(rendered.html, entry.data.password, entry.filePath)
    : undefined;

const published = entry.data.date.toISOString();
const modified = (entry.data.updated ?? entry.data.date).toISOString();

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('common.home'), item: absoluteUrl('/') },
    {
      '@type': 'ListItem',
      position: 2,
      name: typeLabel,
      item: absoluteUrl(listingHref),
    },
    { '@type': 'ListItem', position: 3, name: title, item: absoluteUrl(entry.url) },
  ],
};

const articleLd = isLocked
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: published,
      dateModified: modified,
      author: { '@type': 'Person', name: siteConfig.author },
      publisher: { '@type': 'Person', name: siteConfig.author },
      mainEntityOfPage: absoluteUrl(entry.url),
      image: absoluteUrl(siteConfig.seo.ogImage),
      inLanguage: localeMeta.htmlLang,
      ...(section ? { articleSection: section } : {}),
      ...(keywords.length ? { keywords: [...keywords, ...tags].join(',') } : tags.length ? { keywords: tags.join(',') } : {}),
    };
---

<BaseLayout
  title={title}
  description={description}
  canonical={entry.url}
  type="article"
  noindex={isLocked || entry.data.hideFrom.includes('sitemap')}
  published={published}
  modified={modified}
  keywords={keywords}
  jsonLd={[breadcrumb, ...(articleLd ? [articleLd] : [])]}
  view={isLocked ? 'detail-locked' : 'detail'}
>
  <section class="a-view" data-view="detail" aria-labelledby="a-article-title">
    <div class="a-wrap">
      <div class:list={['a-detail', { 'is-locked': isLocked }]}>
        <aside class="a-detail-rail" aria-hidden="true">
          <p class="a-dr-year">{railParts.year}</p>
          <p class="a-dr-day">{railParts.day}</p>
          <p class="a-dr-wd">{weekdayLabel(railParts.weekday)}</p>
          <p class="a-dr-cat">{category ?? typeLabel}</p>
        </aside>

        <article class="a-article">
          <div
            data-pagefind-body={isIndexable(entry) ? '' : undefined}
            data-pagefind-meta={`date:${dateIso}`}
            data-pagefind-filter={`type:${kind}`}
          >
            <span class="a-sr" data-pagefind-meta={`type:${kind}`} />
            {tags.map((tag) => (
              <span class="a-sr" data-pagefind-filter={`tag:${tag}`} />
            ))}
            {postCategory && <span class="a-sr" data-pagefind-filter={`category:${postCategory}`} />}

            <header>
              {/* 元信息行不进搜索索引：否则 Pagefind 摘录会从日期/分类/阅读时长这些噪声开始。 */}
              <p class="a-meta" data-pagefind-ignore>
                <span class="a-meta-date">{formatDisplayDate(entry.data.date, siteConfig.timezone)}</span>
                {/* 分隔点由 .a-meta > * + *::before 画在父级上；给链接包一层 span，
                    下划线才只覆盖「文章」两个字，不会连「·」一起划进去。 */}
                <span>
                  <a class="a-meta-type" href={listingHref}>{typeLabel}</a>
                </span>
                {isLocked && <span class="a-locked-type">{t('detail.lockedType', { type: typeLabel })}</span>}
                {isPost && tags.length > 0 && (
                  <span class="a-meta-tags">
                    {tags.map((tag, index) => (
                      <>
                        {index > 0 && ' / '}
                        <a href={taxonomyHref('tags', tag)}>{tag}</a>
                      </>
                    ))}
                  </span>
                )}
                <span>{t('detail.readingTime', { minutes: reading })}</span>
                {entry.data.updated && (
                  <span>{t('detail.updated', { date: formatDisplayDate(entry.data.updated, siteConfig.timezone) })}</span>
                )}
                {entry.data.draft && <span class="a-draft">{t('common.draft')}</span>}
              </p>
              <h1
                id="a-article-title"
                class:list={[{ 'a-sr': !hasTitle }]}
                data-pagefind-meta="title"
              >
                {title}
              </h1>
              {isLocked && <p class="a-locked-desc">{description}</p>}
            </header>

            {!isLocked && (
              <>
                <Toc headings={headings} variant="mobile" />
                <div class="a-prose" data-article-body>
                  <RenderedBody rendered={rendered} />
                </div>
              </>
            )}
          </div>

          {isLocked ? (
            <>
              <Toc headings={[]} variant="mobile" force />
              <LockedContent
                client:load
                payload={payload!}
                kind={entry.collection}
                messages={lockedMessages}
                comments={commentOptions(entry.data.comments)}
                endLabel={endLabel}
              />
            </>
          ) : (
            <>
              <div class="a-endmark" aria-hidden="true">
                <span class="a-endmark-rule" />
                <svg
                  class="a-endmark-art"
                  viewBox="0 0 74 46"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                >
                  <path d="M7 38h60" />
                  <path d="M13 24l24-17 24 17" />
                  <path d="M20 24v14h12v-7h8v7h13V24" />
                  <path
                    class="a-ill-accent"
                    d="M55 10c-1.2-.9-4.2-3-4.2-5.4a2.4 2.4 0 0 1 4.2-1.6 2.4 2.4 0 0 1 4.2 1.6c0 2.4-3 4.5-4.2 5.4z"
                  />
                </svg>
                <span class="a-endmark-text">{endLabel}</span>
                <span class="a-endmark-rule" />
              </div>

              <CommentsSection comments={entry.data.comments} />
            </>
          )}
        </article>

        <Toc headings={isLocked ? [] : headings} variant="desktop" force={isLocked} />
      </div>
    </div>
  </section>
</BaseLayout>
