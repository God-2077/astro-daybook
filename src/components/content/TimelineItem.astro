---
import Icon from '../common/Icon.astro';

interface Props {
  /** 日期文本；ISO 日期（YYYY-MM-DD）会渲染为 <time datetime>。 */
  date?: string;
  /** 条目标题；省略时只显示正文。 */
  title?: string;
}

const { date, title } = Astro.props;
const isIsoDate = typeof date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(date);
---

<li class="a-mdx-timeline-item">
  <div class="a-mdx-timeline-rail">
    {
      date &&
        (isIsoDate ? (
          <time class="a-mdx-timeline-date" datetime={date}>{date}</time>
        ) : (
          <span class="a-mdx-timeline-date">{date}</span>
        ))
    }
  </div>
  <div class="a-mdx-timeline-content">
    {title && <p class="a-mdx-timeline-title">{title}</p>}
    <div class="a-mdx-timeline-body"><slot /></div>
  </div>
  <span class="a-mdx-timeline-node" aria-hidden="true">
    <Icon name="i-star" className="a-star" size={9} />
  </span>
</li>
