---
import { t } from '../../i18n/current';
import type { MetingClientSource } from '../../lib/meting-core';
import type { MusicTrack } from '../../lib/music';
import { renderMusicPlayerHtml } from '../../lib/music-player-html';

/**
 * 可放进 MDX 的歌单播放器，也是 Markdown `:::music` 与 `::meting` 指令的共享骨架。
 *
 * 用法：
 * <MusicPlayer
 *   playlist={[{ name: '曲名', url: '/music/song.mp3', artist: '艺人' }]}
 *   autoPlayNext
 *   playlistExpand
 * />
 *
 * DOM 由 src/lib/music-player-html.ts 统一生成，Markdown 指令与 Astro 组件因此产出同一套
 * [data-music] 结构；脚本仍由 src/scripts/client.ts 在页面出现 [data-music] 时按需加载。
 *
 * 单曲（playlist 只有一首）时列表区在样式层隐藏，但曲目 DOM 仍保留：
 * 交互脚本依赖 [data-music-track] 初始化播放器，删掉会让整张卡片无法播放。
 */

interface Props {
  /** 构建期已解析的曲目；与 `metingSource` 二选一。 */
  playlist?: readonly MusicTrack[];
  /** 浏览器端 Meting 数据源；设置后构建期不请求 API。 */
  metingSource?: MetingClientSource;
  /** 播完当前曲目后是否自动播放下一首，默认 false。 */
  autoPlayNext?: boolean;
  /** 是否默认展开播放列表，默认 false。 */
  playlistExpand?: boolean;
}

const html = renderMusicPlayerHtml(Astro.props, t);
---

<Fragment set:html={html} />
