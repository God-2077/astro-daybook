---
import { siteConfig } from '../../config/site';
import { t } from '../../i18n/current';
import { isNavLinkActive, navLabelFor } from '../../lib/nav';
import Icon from '../common/Icon.astro';

const path = Astro.url.pathname || '/';
const items = [
  { title: navLabelFor(siteConfig.nav, '/') ?? siteConfig.labels.diary, href: '/', icon: 'i-book' },
  { title: navLabelFor(siteConfig.nav, '/posts') ?? t('nav.posts'), href: '/posts', icon: 'i-file' },
  { title: navLabelFor(siteConfig.nav, '/friends') ?? t('nav.friends'), href: '/friends', icon: 'i-link' },
  { title: navLabelFor(siteConfig.nav, '/about') ?? t('nav.about'), href: '/about', icon: 'i-user' },
];

function active(href: string): boolean {
  return isNavLinkActive(href, path);
}
---

<nav class="a-bottomnav" aria-label={t('nav.bottom')}>
  {items.map((item) => (
    <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>
      <Icon name={item.icon} />
      <span>{item.title}</span>
    </a>
  ))}
</nav>
