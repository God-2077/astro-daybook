---
import { siteConfig } from '../../config/site';
import { t } from '../../i18n/current';
import { isExternalUrl } from '../../lib/site';
import { currentYearInTimeZone } from '../../lib/time';
import Icon from '../common/Icon.astro';

const currentYear = currentYearInTimeZone(siteConfig.timezone);
const yearRange =
  siteConfig.copyright.yearFrom === currentYear ? `${currentYear}` : `${siteConfig.copyright.yearFrom}–${currentYear}`;
---

<footer class="a-footer">
  <div class="a-wrap a-footer-inner">
    <div class="a-footer-top">
      <span class="a-footer-brand">{siteConfig.footerBrand}</span>
      <nav class="a-footer-nav" aria-label={t('nav.footer')}>
        {siteConfig.footerNav.map((item) => (
          <a
            href={item.link}
            target={isExternalUrl(item.link) ? '_blank' : undefined}
            rel={isExternalUrl(item.link) ? 'noopener' : undefined}
          >
            {item.title}
          </a>
        ))}
      </nav>
    </div>

    <div class="a-footer-bottom">
      <p class="a-footer-copy">
        {siteConfig.copyright.enabled && (
          <span class="a-footer-copyright">© {yearRange} {siteConfig.copyright.author}</span>
        )}
        {siteConfig.copyright.enabled && siteConfig.icp.length > 0 && (
          <span class="a-footer-sep" aria-hidden="true">·</span>
        )}
        {siteConfig.icp.length > 0 && (
          <span class="a-footer-icp">
            {siteConfig.icp.map((item, index) => (
              <Fragment>
                {index > 0 && ' · '}
                {item.link ? (
                  <a
                    href={item.link}
                    target={isExternalUrl(item.link) ? '_blank' : undefined}
                    rel={isExternalUrl(item.link) ? 'noopener' : undefined}
                  >{item.text}</a>
                ) : (
                  <span>{item.text}</span>
                )}
              </Fragment>
            ))}
          </span>
        )}
      </p>
      <p class="a-footer-credit">
        <Icon name="i-star" />
        <span>Powered by <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> &amp; <a href="https://github.com/God-2077/astro-daybook" target="_blank" rel="noopener" title="Daybook（纸页日记）">Daybook</a></span>
      </p>
    </div>

    <div class="a-footer-doodle" aria-hidden="true">
      <svg viewBox="0 0 780 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M0 50c54-4 104 3 158 0s104-4 158 0 104 3 158 0 104-4 158 0 104 3 148 0" opacity=".7"></path>
        <path d="M118 50V30l22-14 22 14v20"></path>
        <path d="M152 50V36h10v14"></path>
        <path d="M126 37h8v7h-8z" opacity=".7"></path>
        <path class="a-ill-accent" d="M156 10c-1-.8-3-2.2-3-4a1.7 1.7 0 0 1 3-1.1 1.7 1.7 0 0 1 3 1.1c0 1.8-2 3.2-3 4z"></path>
        <path d="M300 50V41"></path>
        <path d="M290 43l10-11 10 11z"></path>
        <path d="M293 34l7-9 7 9z" opacity=".9"></path>
        <path d="M610 50v-9M622 50v-9M634 50v-9M610 46h24M610 50h24" opacity=".7"></path>
        <path class="a-ill-accent" d="M686 14l1.3 3.8 3.8 1.3-3.8 1.3-1.3 3.8-1.3-3.8-3.8-1.3 3.8-1.3z"></path>
      </svg>
    </div>
  </div>
</footer>
